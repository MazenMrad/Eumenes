DISCORD_BOT_TOKEN=your_discord_bot_token_here
ADMIN_ROLE_ID=optional_discord_role_id_for_admin_commands
GUILD_ID=your_server_id_for_instant_command_sync

# Hugging Face backup (auto-creates a private dataset on first backup)
HF_TOKEN=your_hf_write_token_here
HF_BACKUP_REPO=your-username/eumenes-backup
HF_BACKUP_INTERVAL=300

# Health server port (for HF Spaces keep-alive pings)
HEALTH_PORT=7860

# Cloudflare API token — auto-creates a Worker to ping the Space every 5 min
CLOUDFLARE_WORKERS_TOKEN=your_cloudflare_api_token_here
